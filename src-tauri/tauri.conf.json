{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Good Luck Rahman",
  "version": "0.1.0",
  "identifier": "com.goodluckrahman.enterprise",

  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": null,
    "frontendDist": "../frontend"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Good Luck Rahman Enterprise",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/goodluck-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}