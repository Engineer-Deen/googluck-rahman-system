# Copy this file to .env and fill in real values.
# Never commit the real .env file to GitHub.

# "local" for a shop PC (SQLite, offline-first)
# "central" for the cloud server (PostgreSQL)
GLR_MODE=local

# Only needed when GLR_MODE=central. Example for a local Postgres you
# already have installed:
DATABASE_URL=postgresql+psycopg2://glr_user:glr_pass@localhost:5432/glr_central

# Where local devices send their sync outbox
CENTRAL_SYNC_URL=http://localhost:8000

# Optional bootstrap values for a fresh central database.
INITIAL_SHOP_NAME=Main Shop
INITIAL_SHOP_LOCATION=Freetown
INITIAL_OWNER_EMAIL=owner@glr.test
INITIAL_OWNER_PASSWORD=owner123
INITIAL_ADMIN_EMAIL=admin@glr.test
INITIAL_ADMIN_PASSWORD=admin123
INITIAL_CASHIER_EMAIL=cashier@glr.test
INITIAL_CASHIER_PASSWORD=cashier123
INITIAL_PRODUCT_SKU=RICE-50KG
INITIAL_PRODUCT_NAME=Bag of Rice (50kg)
INITIAL_PRODUCT_CATEGORY=Grains
INITIAL_PRODUCT_UNIT_PRICE=450
INITIAL_PRODUCT_COST_PRICE=350

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
SYNC_API_KEY=change-me

# Central provider: postgres (default fallback) or firestore.
CENTRAL_DATA_PROVIDER=postgres

# Required only when CENTRAL_DATA_PROVIDER=firestore. Use Render secrets;
# never commit the JSON value or a service-account file.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=/etc/secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_DATABASE=(default)
