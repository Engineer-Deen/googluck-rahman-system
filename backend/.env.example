# Copy this file to .env and fill in real values.
# Never commit the real .env file to GitHub.

# "local" for a shop PC (SQLite, offline-first)
# "central" for the cloud server
GLR_MODE=local

# Only needed when GLR_MODE=central.
DATABASE_URL=postgresql+psycopg2://glr_user:glr_pass@localhost:5432/glr_central

# Where local devices send their sync outbox
CENTRAL_SYNC_URL=http://localhost:8000

# Shop branding used on first bootstrap (also editable later in System Settings).
INITIAL_SHOP_NAME=Good Luck Rahman Enterprise
INITIAL_SHOP_LOCATION=

# Production / customer owner & staff credentials for first-run bootstrap.
# These are hashed by the backend and never stored in frontend code.
# Leave unset (and keep ALLOW_DEMO_SEED=false) to skip creating demo accounts.
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_PASSWORD=
INITIAL_OWNER_NAME=Owner
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Admin
INITIAL_CASHIER_EMAIL=
INITIAL_CASHIER_PASSWORD=
INITIAL_CASHIER_NAME=Cashier

# Development only. When true, missing INITIAL_* credentials fall back to
# demo accounts (*.glr.test). Keep false for customer / production installs.
ALLOW_DEMO_SEED=false

# One-time replacement of an existing demo/admin account (optional).
# Set these once on Render, restart once, confirm login, then remove the
# password (and preferably the token) from the environment.
# The same token is recorded after success and will not re-apply.
BOOTSTRAP_CREDENTIAL_UPDATE_TOKEN=
BOOTSTRAP_TARGET_EMAIL=
BOOTSTRAP_NEW_PASSWORD=
BOOTSTRAP_NEW_EMAIL=
BOOTSTRAP_NEW_NAME=
BOOTSTRAP_NEW_ROLE=

# Optional first product on a fresh central database (skipped if SKU blank).
INITIAL_PRODUCT_SKU=
INITIAL_PRODUCT_NAME=
INITIAL_PRODUCT_CATEGORY=
INITIAL_PRODUCT_UNIT_PRICE=
INITIAL_PRODUCT_COST_PRICE=

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
SYNC_API_KEY=change-me

# Central provider: postgres (default fallback) or firestore.
CENTRAL_DATA_PROVIDER=postgres

# Required only when CENTRAL_DATA_PROVIDER=firestore. Use Render secrets;
# never commit the JSON value or a service-account file.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=/etc/secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_DATABASE=(default)
